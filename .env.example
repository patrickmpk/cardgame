# Pockemy Card Battle — Environment Variables

# === SERVER ===

# Port for the Socket.io game server (default: 3001)
# PORT=3001

# Allowed CORS origins (comma-separated). Default: http://localhost:5173
# CLIENT_ORIGIN=http://localhost:5173

# Set to "true" to allow any CORS origin
# ALLOW_ANY_ORIGIN=false

# Delay before the AI bot joins as opponent (ms, default: 6500)
# BOT_MATCH_DELAY_MS=6500

# Clerk Secret Key (from https://clerk.com)
# Used by the server to verify JWT tokens from Socket.io clients
# CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# OpenRouter API key for the AI-powered bot opponent
# Get one at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxx

# Neon PostgreSQL connection string (for player profiles, match history, leaderboard)
# Create a free database at: https://neon.tech
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# === CLIENT (Vite) ===

# Clerk Publishable Key (from https://clerk.com)
# Used by the frontend to authenticate users
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# WebSocket URL for the game server (default: auto-detects localhost:3001)
# VITE_SOCKET_URL=http://localhost:3001
